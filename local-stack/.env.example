# ==========================================================
# CaesarAICareerOpsAmari — Local Stack Environment Configuration
# Main Provider: PostgreSQL (Persistent Docker Volume)
# ==========================================================

# Port and Environment
ENVIRONMENT=local
PORT=8002
HOST=127.0.0.1

# PostgreSQL Settings for Docker Service
POSTGRES_USER=caesar
POSTGRES_PASSWORD=caesar_ops_password
POSTGRES_DB=caesar_ops_amari
POSTGRES_PORT=5434

# Connection Strings:
# 1. Host mode (when running python3 application.py directly on your machine):
DATABASE_URL=postgresql://caesar:caesar_ops_password@localhost:5434/caesar_ops_amari

# 2. Container mode (automatically used inside docker-compose):
# DATABASE_URL=postgresql://caesar:caesar_ops_password@postgres-amari:5432/caesar_ops_amari

# 3. Supabase Cloud PostgreSQL (toggle whenever desired):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Paths
CAREER_OPS_DIR=backend/career-ops
DATA_DIR=data
