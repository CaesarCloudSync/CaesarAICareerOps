{
  "manifest_version": 3,
  "name": "CaesarAI Autofill Copilot",
  "version": "2.0.0",
  "description": "AI-Powered Live DOM Form Autofill with agy for Greenhouse, Ashby, Lever, Workday",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CaesarAI Autofill (agy)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "run_autofill": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Trigger CaesarAI Autofill"
    }
  }
}
